    print_info "6. Testing POST /auth/login - Valid"
    response=$(curl -s -w "\n%{http_code}" -X POST \
        "${BASE_URL}/auth/login" \
        -H "Content-Type: application/json" \
        -d '{
            "email": "testuser@example.com",
            "password": "SecurePass123!"
        }')
